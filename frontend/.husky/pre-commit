# Formats staged files with Prettier, the same two runs CI checks: `src/` with
# the frontend config and root Markdown with the root ignore file. Agents commit
# through `git commit`, where no editor format-on-save ever fires.
#
# Calls the binary directly, because `pnpm exec` through a symlinked node_modules
# can purge the main tree's copy.
modules=frontend/node_modules/.bin

# A worktree still installing has no node_modules, and skipping silently here caused format failures in CI.
if [ ! -x "$modules/lint-staged" ]; then
  main_checkout=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
  modules="$main_checkout/frontend/node_modules/.bin"
fi

if [ ! -x "$modules/lint-staged" ]; then
  echo "pre-commit: frontend dependencies are not installed, so staged files were not formatted. CI still checks them." >&2
  exit 0
fi

# Absolute, because lint-staged runs each config from its own folder and they all call prettier by name.
case "$modules" in
  /*) ;;
  *) modules="$PWD/$modules" ;;
esac
PATH="$modules:$PATH" "$modules/lint-staged"
