{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "src/app/sw.ts",
    // The top-level react-email previews (`pnpm email`), listed by name: `src/emails/*.tsx` makes Fallow 3.38 warn that `*` no longer reaches `_preview/` and `components/`, which must stay reached by import. A new preview file has to be added here.
    "src/emails/{account-exists-email,breached-password-email,change-email-confirmation,complete-sign-up-email,email-changed-email,password-changed-email,password-reset-email,reauth-code-email,set-password-email,verification-email}.tsx",
    // Scripts run by hand with `node`, so a new one outside `generate-*` is added here; check-i18n.mjs and migrate.mjs come from package.json and the Dockerfile, and scripts/lib is reached by import.
    "scripts/{generate-*,i18n-add-namespace,optimize-store-logos,seed-dev-account}.mjs"
  ],
  "boundaries": {
    "zones": [
      {
        "name": "app",
        "patterns": ["src/app/**"]
      },
      {
        "name": "shared",
        "patterns": [
          "src/components/**",
          "src/constants/**",
          "src/context/**",
          "src/db/**",
          "src/emails/**",
          "src/hooks/**",
          "src/i18n/**",
          "src/lib/**",
          "src/typings/**",
          "src/utils/**"
        ]
      }
    ],
    "rules": [
      {
        "from": "app",
        "allow": ["shared"]
      },
      {
        "from": "shared",
        "allow": []
      }
    ]
  },
  "ignoreExports": [
    {
      "file": "src/components/ui/**",
      "exports": ["*"]
    },
    {
      "file": "src/components/reui/**",
      "exports": ["*"]
    },
    {
      "file": "src/lib/store-locations/dgu/dgu-{attribution,address-lookup}.ts",
      "exports": ["DGU_ATTRIBUTION"]
    },
    // AGENTS.md routes every redirect through this module, so it stays exported even while no page uses it.
    {
      "file": "src/i18n/navigation.ts",
      "exports": ["redirect"]
    }
  ],
  "ignoreDependencies": [
    "@react-email/ui",
    "baseline-browser-mapping",
    "esbuild",
    "serwist"
  ],
  "health": {
    "maxCrap": 420,
    "ignore": ["src/components/ui/**"]
  },
  "audit": {
    "gate": "new-only",
    "healthBaseline": ".fallow-baselines/health.json",
    "dupesBaseline": ".fallow-baselines/dupes.json"
  },
  "rules": {
    // Every remaining eslint-disable is deliberate and reviewed; as of Fallow 3.37 there is no baseline or reason exemption for them.
    "added-suppression": "off"
  },
  "ignoreExportsUsedInFile": true,
  "ignoreFindings": ["**/products/components/view-switcher.tsx"],
  "duplicates": {
    "ignore": ["src/app/globals.css", "src/i18n/messages/*/index.ts"]
  }
}
