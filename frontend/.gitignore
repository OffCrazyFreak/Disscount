# dependencies
/node_modules
# husky's generated hooks, linked from the main checkout inside a worktree
/.husky/_
/.pnp
.pnp.*

# testing
/coverage
/.vitest

# next.js
/.next/
/out/

# serwist (generated service worker)
public/sw*
public/swe-worker*

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# typescript
*.tsbuildinfo
next-env.d.ts

/api-example
# Sentry Config File
.env.sentry-build-plugin
