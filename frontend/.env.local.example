NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (shared Postgres with the Spring backend; used by better-auth + drizzle-kit)
DATABASE_URL=postgresql://user:password@localhost:5432/disscount

# Better Auth
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Facebook OAuth (server-only; from the Meta app: App ID / App Secret)
FACEBOOK_CLIENT_ID=your_facebook_app_id_here
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret_here

# Resend Email API
RESEND_API_KEY=re_your_resend_api_key_here
# Sender for transactional emails. Must exactly match a verified Resend domain.
EMAIL_FROM="Disscount <noreply@disscount.me>"

# Cijene API Configuration
CIJENE_API_URL=https://api.cijene.dev
CIJENE_API_TOKEN=bearer_token

# Optional, server-only: Geoapify geocoding for store locations the chains and
# the DGU register cannot place. The sync skips Geoapify while this is empty.
GEOAPIFY_API_KEY=

NEXT_PUBLIC_ENABLE_REACT_SCAN=false
# React Query devtools; its floating button overlaps the mobile bottom nav
NEXT_PUBLIC_ENABLE_REACT_QUERY_DEVTOOLS=false

# Umami Analytics
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your_umami_website_id_here

# Sentry error tracking. Public by design (it ships in the JS bundle), and optional
# locally: an empty DSN disables the SDK. Baked at build time, so changing it in a
# deployed environment needs a redeploy, not a restart.
NEXT_PUBLIC_SENTRY_DSN=
# Sentry environment tag (production, staging, local). Also baked at build time through
# next.config.ts; empty falls back to NODE_ENV.
SENTRY_ENVIRONMENT=
# Dev test account (local tooling, not read by the app). A throwaway user on a
# local or dev database, for manual checks and for agents comparing screens.
# Create it with POST /api/auth/sign-up/email, then set "user".email_verified to
# true in that database, since no verification email reaches a made-up address.
# Never a real person's account, and never one that exists on production.
DEV_ACCOUNT_EMAIL=
DEV_ACCOUNT_PASSWORD=
