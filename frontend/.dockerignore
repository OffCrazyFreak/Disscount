# Dependencies & build output (the image installs/builds these itself)
node_modules
.next
out

# Secrets / local env, supplied at runtime and never baked into the image
.env.local
.env*.local
.env.sentry-build-plugin

# Images are published publicly, so any env file stays out, examples aside
.env
.env.*
!.env*.example

# VCS / tooling / OS noise
.git
.gitignore
*.tsbuildinfo
npm-debug.log*
.DS_Store
.vscode
.idea
