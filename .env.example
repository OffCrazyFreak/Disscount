# =============================================================================
# Docker Compose environment for the FULL local stack (db + backend + frontend).
# Copy this file to ".env" and fill in real values. URLs use Docker service
# names (db / backend / frontend) for in-network calls.
# =============================================================================

# ---- PostgreSQL (db service) ----
POSTGRES_DB=disscount
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# ---- Backend (Spring Boot) runtime ----
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/disscount
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change_me
# Backend validates better-auth JWTs: fetch JWKS over the Docker network (frontend service),
# but the issuer claim is the browser-facing URL, and it MUST equal BETTER_AUTH_URL.
BETTER_AUTH_JWKS_URI=http://frontend:3000/api/auth/jwks
BETTER_AUTH_ISSUER=http://localhost:3000
# Backend Sentry project DSN (Settings -> Projects -> disscount-backend -> Client Keys)
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
# Verbose SDK init/transport logging for debugging; leave false normally
SENTRY_DEBUG=false
# Card photos: private Cloudflare R2 bucket created with jurisdiction EU, so the endpoint is
# https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com. Leave all four blank to switch photos off.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Product photos: a second, public R2 bucket (jurisdiction EU, same endpoint) with its own token scoped to it,
# served through a custom domain such as https://images.example.com. Leave all four blank to switch product photos off.
R2_PUBLIC_BUCKET=
R2_PUBLIC_ACCESS_KEY_ID=
R2_PUBLIC_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# ---- Frontend build args (NEXT_PUBLIC_*: baked into the browser bundle at build) ----
# Internal URL for server-side rewrites/SSR; the browser uses relative /api and ignores this.
NEXT_PUBLIC_API_URL=http://backend:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your_umami_website_id
# React Query devtools; its floating button overlaps the mobile bottom nav
NEXT_PUBLIC_ENABLE_REACT_QUERY_DEVTOOLS=false
# Frontend Sentry project DSN (disscount-frontend): public DSN, used at build + runtime
NEXT_PUBLIC_SENTRY_DSN=

# ---- Frontend runtime secrets (server-only; never baked into the bundle) ----
DATABASE_URL=postgresql://postgres:change_me@db:5432/disscount
BETTER_AUTH_SECRET=your_better_auth_secret
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_SECRET=your_google_client_secret
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="Disscount <noreply@disscount.me>"
CIJENE_API_URL=https://api.cijene.dev
CIJENE_API_TOKEN=your_cijene_token
# Optional: Geoapify key for geocoding stores without coordinates
GEOAPIFY_API_KEY=

# ---- Sentry source-map upload (build-time, optional) ----
# Only used by CI/prod image builds to upload source maps; NOT used by the local build.
SENTRY_AUTH_TOKEN=

# ---- Image-based deploys (docker-compose.images.yml only; Dokploy sets it per environment) ----
# Moving GHCR tag the server pulls: dev for development, prod for production.
IMAGE_TAG=dev

# ---- Backups (docker-compose.images.yml, production only; see docs/BACKUPS.md) ----
# The backup service starts only when this includes "backup"; leave it unset on dev and locally.
COMPOSE_PROFILES=
# EU-jurisdiction R2 bucket used only for backups, and a token scoped to it (Object Read & Write).
BACKUP_R2_ENDPOINT=https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com
BACKUP_R2_BUCKET=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# rclone crypt keys for the photo copies: two long random strings, kept offline as well. Losing them loses the photo backups.
BACKUP_CRYPT_PASSWORD=
BACKUP_CRYPT_SALT=
# age public key (age1...) that encrypts the database and Dokploy dumps; the private key stays offline with the owner.
BACKUP_AGE_RECIPIENT=
# healthchecks.io project ping key; blank sends no pings.
BACKUP_HEALTHCHECKS_PING_KEY=
# Password of Dokploy's own database (user dokploy), for the nightly Dokploy config backup.
BACKUP_DOKPLOY_DB_PASSWORD=
