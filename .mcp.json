{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["@upstash/context7-mcp@1.0.31"],
      "env": { "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}" }
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@microsoft/postgres-mcp@0.1.0-rc.9",
        "run",
        "--no-telemetry"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "--registry",
        "https://registry.npmjs.org",
        "chrome-devtools-mcp@1.4.0",
        "--executablePath",
        "/opt/helium/chrome"
      ]
    },
    "dokploy": {
      "command": "npx",
      "args": ["-y", "@dokploy/mcp@0.30.7"],
      "env": {
        "DOKPLOY_URL": "https://dokploy.disscount.me",
        "DOKPLOY_API_KEY": "${DOKPLOY_API_KEY}"
      }
    },
    "sentry": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp/disscount"
    },
    "resend": {
      "type": "http",
      "url": "https://mcp.resend.com/mcp"
    }
  }
}
