SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/database_name
SPRING_DATASOURCE_USERNAME=username
SPRING_DATASOURCE_PASSWORD=password

# Better Auth JWKS endpoint (Next.js) used to verify incoming JWTs
BETTER_AUTH_JWKS_URI=http://localhost:3000/api/auth/jwks
# Expected issuer claim on those JWTs. Must equal the frontend's BETTER_AUTH_URL.
# Required: outside the local profile the app refuses to start without it.
BETTER_AUTH_ISSUER=http://localhost:3000

# Sentry error tracking (optional locally), an empty DSN disables the SDK
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_DEBUG=false

# Card photos on Cloudflare R2 (optional). Leaving any of these four blank disables photos.
# Create the bucket with jurisdiction EU, which makes the endpoint https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
