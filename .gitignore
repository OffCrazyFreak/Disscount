
# --- General ---
*.log
*.tmp
*.swp
.DS_Store
Thumbs.db

# T3 Code workspace configuration
/t3.json

# --- OS ---
.idea/
# Ignore the folder's contents rather than the folder itself, because git cannot
# re-include a file whose parent directory is excluded, and mcp.json ships.
.vscode/*
!.vscode/mcp.json
.history/
.env
.env.*
!.env.example

