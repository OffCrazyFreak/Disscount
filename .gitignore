backend/target/
backend/.gradle/
backend/.classpath
backend/.project
backend/.settings/
backend/.apt_generated/
backend/.factorypath
backend/.springBeans
backend/.sts4-cache
backend/build/
backend/HELP.md
backend/.mvn/wrapper/maven-wrapper.jar
!backend/src/**/target/
!backend/src/**/build/

# IDE files
backend/.idea/
backend/*.iml
backend/*.ipr
backend/*.iws

