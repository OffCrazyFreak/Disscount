desktop.ini

docs/disscount_*
# Playwright MCP session artifacts
.playwright-mcp/

# Screenshots dropped at the repo root; real ones belong under docs/
/*.png
/*.jpg
/*.jpeg
/*.webp

# Local code-review triage output (not committed)
reviews/

# Agent worktrees are full copies of the repo. Matched only by .git/info/exclude
# until now, which is per-clone and never committed, so a fresh clone or a CI
# checkout would have staged the whole duplicate tree. The rest of the Claude Code
# runtime state is here for the same reason: local overrides, machine-specific
# scheduler and daemon files, and per-session scratch that no clone should carry.
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.json
.claude/scheduled_tasks.lock
.claude/routines/.state/
.claude/checkpoints/
.claude/mailbox/
.claude/agent-registry.json
.claude/agent-memory-local
.claude/first-run
.claude/assistant-daemon-state.json

# Built email bundles, regenerated by marketing/emails/build-zip.mjs
marketing/emails/dist/
