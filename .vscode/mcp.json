{
  "servers": {
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["@upstash/context7-mcp@1.0.31"],
      "env": { "CONTEXT7_API_KEY": "${env:CONTEXT7_API_KEY}" }
    },
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp"
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--registry",
        "https://registry.npmjs.org",
        "chrome-devtools-mcp@1.4.0"
      ]
    },
    "dokploy": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@dokploy/mcp@0.30.7"],
      "env": {
        "DOKPLOY_URL": "https://dokploy.disscount.me",
        "DOKPLOY_API_KEY": "${env:DOKPLOY_API_KEY}"
      }
    },
    "sentry": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp/disscount"
    }
  }
}
