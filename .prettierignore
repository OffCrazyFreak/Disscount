# Prettier ignores for repo-root runs.
# The frontend has its own .prettierrc + .prettierignore and is checked separately in CI.

# Dependencies & build output
**/node_modules
**/.next
**/target

# Agent worktrees are full copies of the repo, gitignored so CI never sees them.
# Without this the docs check sweeps up whichever worktree happens to be open
# and fails locally on files that are not in the repo, so local and CI disagree.
.claude/worktrees/

# Lockfiles
**/pnpm-lock.yaml

# Binary assets
**/*.png
**/*.webp
**/*.gif
**/*.ico

# Private, secret-containing docs (also gitignored) and generated HTML
docs/disscount_*
docs/*.html

# Email HTML is pasted into an ESP verbatim; Prettier rewrites quoted font names
# to &quot; entities, which not every email client's CSS parser handles.
marketing/emails/*.html
