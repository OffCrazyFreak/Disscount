{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./node_modules/.bin/tsc --noEmit)",
      "Bash(pnpm exec tsc --noEmit)",
      "Bash(./node_modules/.bin/eslint *)",
      "Bash(pnpm exec eslint *)",
      "Bash(./node_modules/.bin/next lint *)",
      "Bash(pnpm lint)",
      "Bash(./node_modules/.bin/prettier --check *)",
      "Bash(pnpm exec prettier --check *)",
      "Bash(git fetch *)",
      "Bash(git merge-base *)",
      "Bash(gh pr checks *)",
      "mcp__context7",
      "mcp__playwright",
      "mcp__cloudflare-api__docs",
      "mcp__cloudflare-api__search"
    ],
    "deny": [
      "mcp__playwright__browser_run_code_unsafe",
      "Bash(pnpm dev)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm run dev)",
      "Bash(pnpm run dev:*)",
      "Bash(next dev)",
      "Bash(next dev:*)",
      "Bash(pnpm email)",
      "Bash(pnpm email:*)",
      "Bash(pnpm run email)",
      "Bash(pnpm run email:*)",
      "Bash(mvn spring-boot:run)",
      "Bash(mvn spring-boot:run:*)",
      "Bash(./mvnw spring-boot:run)",
      "Bash(./mvnw spring-boot:run:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(dokploy:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-commands.py"
          }
        ]
      }
    ]
  }
}
